    <Style src="project://database/Assets/_Project/_UI/Toolkit/_Uss/InGame.uss?fileID=7433441132597879392&amp;guid=5922154032e139245aa8219485f78663&amp;type=3#InGame"/>
    <ui:VisualElement name="mian-container">
        <ui:VisualElement name="score-container" class="score-container">
